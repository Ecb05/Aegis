{
  "manifest_version": 3,
  "name": "Hermes",
  "version": "0.1.0",
  "description": "Privacy-preserving runtime for lightweight browser agents",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "tabs",
    "storage",
    "debugger",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "ui/sidepanel/sidepanel.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "web_accessible_resources": [
    {
      "resources": ["offscreen/*", "wasm/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
